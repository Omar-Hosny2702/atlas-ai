# Copy this file to .env and adjust as needed.

# Port the Express server listens on
PORT=8787

# Origin(s) allowed to call this API (comma-separated). Use the frontend dev
# server URL in development.
CORS_ORIGIN=http://localhost:5173

# Where Ollama's HTTP API is reachable. Default is Ollama's local default.
OLLAMA_HOST=http://127.0.0.1:11434

# Default model used when a conversation doesn't specify one.
# Must match an id in ai/modelConfig.ts and be pulled locally via
# `ollama pull <id>`.
DEFAULT_MODEL=llama3.1:8b

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/atlas.db

# Max requests per IP per minute for the chat endpoint.
RATE_LIMIT_PER_MINUTE=30

# Log level: error | warn | info | debug
LOG_LEVEL=info
