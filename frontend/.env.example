# Copy this file to .env and adjust as needed.

# Base URL of the Atlas AI backend API. Leave as /api in development — the
# Vite dev server proxies it to the backend (see vite.config.ts). In
# production, point this at wherever the backend is actually deployed.
VITE_API_BASE_URL=/api

# Auth0 configuration for the SPA login flow and Atlas backend audience.
# The client app must request an access token for the same audience the backend
# validates in backend/.env (AUTH0_AUDIENCE).
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://api.example.com
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/callback
VITE_AUTH0_SCOPE=openid profile email offline_access
