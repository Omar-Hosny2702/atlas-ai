{
  "name": "atlas-ai-frontend",
  "version": "1.0.0",
  "description": "Atlas AI — a polished, ChatGPT-style web client for local open-source LLMs.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
